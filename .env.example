PYTHONUNBUFFERED=1
PIP_DISABLE_PIP_VERSION_CHECK=1

MET_DATA_CSV=data/raw/met_data.csv
MET_IMAGES_DIR=data/raw/images
MET_ARTIFACTS_DIR=artifacts
MET_AUTO_BUILD_ON_STARTUP=false
MET_EMBEDDING_BACKEND=clip
MET_CLIP_MODEL_NAME=ViT-B-32
MET_CLIP_PRETRAINED=laion2b_s34b_b79k
MET_CLIP_DEVICE=cpu
MET_CLIP_BATCH_SIZE=32
MET_CLIP_TEXT_WEIGHT=0.5
MET_CLIP_IMAGE_WEIGHT=0.5
MET_CLIP_RETRIEVAL_WEIGHT=0.8
MET_CLIP_LEXICAL_WEIGHT=0.2
MET_CLIP_PROMPT_ENSEMBLE=true

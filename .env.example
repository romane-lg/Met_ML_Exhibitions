PYTHONUNBUFFERED=1
PIP_DISABLE_PIP_VERSION_CHECK=1
# Prevents segfault on macOS caused by conflicting OpenMP runtimes (PyTorch vs scikit-learn/lightgbm)
KMP_DUPLICATE_LIB_OK=TRUE
# Prevents segfault on macOS when Streamlit forks a process after PyTorch/ObjC runtime is initialized
OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES
# Prevents OpenMP thread pool corruption on macOS when PyTorch (libiomp5) and scikit-learn/lightgbm (libomp) are both loaded
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1

MET_DATA_CSV=data/raw/met_data.csv
MET_IMAGES_DIR=data/raw/images
MET_ARTIFACTS_DIR=artifacts
MET_AUTO_BUILD_ON_STARTUP=false
MET_EMBEDDING_BACKEND=clip
MET_CLIP_MODEL_NAME=ViT-B-32
MET_CLIP_PRETRAINED=laion2b_s34b_b79k
# Device for CLIP inference. Leave unset to auto-detect (uses 'mps' on Apple Silicon, 'cpu' elsewhere).
# Override with 'cpu' to force CPU on any platform, or 'mps' to force Apple GPU.
MET_CLIP_DEVICE=cpu
MET_CLIP_BATCH_SIZE=32
MET_CLIP_TEXT_WEIGHT=0.5
MET_CLIP_IMAGE_WEIGHT=0.5
MET_CLIP_RETRIEVAL_WEIGHT=0.8
MET_CLIP_LEXICAL_WEIGHT=0.2
MET_CLIP_PROMPT_ENSEMBLE=true
